# Firewall filter — 24 static rules, 11 in chain=input and 13 in chain=forward.
#
# THIS FILE IS ORDINAL. RouterOS evaluates filter rules top-to-bottom and both
# chains end in a terminal drop, so the order of the rules is part of the
# configuration. Terraform does not order resources, so the order is asserted
# separately by the routeros_move_items resource at the bottom of this file.
# Adding, removing or reordering a resource here means the `sequence` list in
# that resource MUST be updated to match.
#
# Transcribed verbatim from the live device. Every rule is imported by its
# RouterOS internal .id (see imports.tf), so no rule is ever created and the
# first apply cannot renumber the chains.
#
# The one dynamic row in this menu — *77, action=passthrough,
# "special dummy rule to show fasttrack counters" — is generated by RouterOS
# itself and is deliberately NOT managed and NOT part of the move sequence.
#
# Omitted on purpose across all rules:
#   log       — false on every live rule. The provider suppresses the diff for
#               attributes the user did not set (AlwaysPresentNotUserProvided),
#               so leaving it out is drift-free.
#   log_prefix — only set where the device actually has a non-empty value
#               (rules 4 and 5). Note the device has log=no together with a
#               log-prefix on those two, which means the prefix is inert; it is
#               reproduced because it is what is live, not because it does
#               anything.
#   hw_offload — not present on any live row, including the two
#               fasttrack-connection rules.

# ---------------------------------------------------------------------------
# chain=input  (rules 1-5)
# ---------------------------------------------------------------------------

# 1
resource "routeros_ip_firewall_filter" "input_accept_estab" {
  chain            = "input"
  action           = "accept"
  comment          = "Allow Estab & Related"
  connection_state = "established,related"
}

# 2 — hardened 2026-07-30 (report finding 3): was in-interface-list=VLAN,
# which exposed SSH/WinBox/WebFig to IOT and UNTRUSTED. Now only the MGMT
# list (BASE_VLAN + TRUSTED_VLAN) gets full router access; the other VLANs
# keep the specific services they need via rules 2a-2e below.
# depends_on the members: the list must be populated before this rule narrows,
# or management access (including the provider's own REST session) would drop
# mid-apply.
resource "routeros_ip_firewall_filter" "input_accept_vlan" {
  chain             = "input"
  action            = "accept"
  comment           = "Allow Management VLANs to Router"
  in_interface_list = routeros_interface_list.mgmt.name

  depends_on = [
    routeros_interface_list_member.mgmt_base_vlan,
    routeros_interface_list_member.mgmt_trusted_vlan,
  ]
}

# 3 — deliberately redundant with rule 2 (BASE_VLAN is a member of MGMT):
# kept as a belt-and-braces guarantee that the recovery VLAN retains router
# access even if the MGMT list is ever emptied or mis-edited. Live counters
# show 0 packets (rule 2 always matches first); that is expected.
resource "routeros_ip_firewall_filter" "input_accept_base_vlan" {
  chain        = "input"
  action       = "accept"
  comment      = "Allow Base_Vlan Full Access"
  in_interface = routeros_interface_vlan.base_vlan.name
}

# 3a-3e — service carve-outs for the VLANs no longer covered by rule 2.
# DNS for every VLAN whose DHCP network hands out the router as resolver
# (TRUSTED/SERVER/UNTRUSTED/BASE; IOT uses 1.1.1.1/8.8.8.8 directly).
resource "routeros_ip_firewall_filter" "input_accept_dns_udp" {
  chain             = "input"
  action            = "accept"
  comment           = "DNS from VLANs (udp)"
  protocol          = "udp"
  dst_port          = "53"
  in_interface_list = routeros_interface_list.vlan.name
}

resource "routeros_ip_firewall_filter" "input_accept_dns_tcp" {
  chain             = "input"
  action            = "accept"
  comment           = "DNS from VLANs (tcp)"
  protocol          = "tcp"
  dst_port          = "53"
  in_interface_list = routeros_interface_list.vlan.name
}

# DHCP renewals are unicast to the server address and traverse chain=input.
resource "routeros_ip_firewall_filter" "input_accept_dhcp" {
  chain             = "input"
  action            = "accept"
  comment           = "DHCP from VLANs"
  protocol          = "udp"
  dst_port          = "67"
  in_interface_list = routeros_interface_list.vlan.name
}

# Cilium BGP peers (logos/pneuma/ontos) connect to 10.0.20.1:179 — without
# this, the cluster's LoadBalancer advertisement dies.
resource "routeros_ip_firewall_filter" "input_accept_bgp" {
  chain            = "input"
  action           = "accept"
  comment          = "BGP from k8s cluster (Cilium)"
  protocol         = "tcp"
  dst_port         = "179"
  src_address_list = "k8s-cluster"
}

# The ExternalDNS webhook provider in the cluster manages the router's static
# DNS records over the REST API (www/www-ssl). Its pods egress with the node
# address, so only the three node IPs (k8s-nodes list) are allowed. Added
# 2026-07-30 after the input lockdown broke ExternalDNS reconciliation.
resource "routeros_ip_firewall_filter" "input_accept_externaldns_api" {
  chain            = "input"
  action           = "accept"
  comment          = "ExternalDNS REST API from k8s nodes"
  protocol         = "tcp"
  dst_port         = "80,443"
  src_address_list = "k8s-nodes"

  depends_on = [
    routeros_ip_firewall_addr_list.k8s_nodes_logos,
    routeros_ip_firewall_addr_list.k8s_nodes_ontos,
    routeros_ip_firewall_addr_list.k8s_nodes_pneuma,
  ]
}

# The mDNS repeater listens on IOT_VLAN and TRUSTED_VLAN (see dns.tf);
# TRUSTED is covered by MGMT, IOT needs this carve-out.
resource "routeros_ip_firewall_filter" "input_accept_mdns_iot" {
  chain        = "input"
  action       = "accept"
  comment      = "mDNS repeater (IOT_VLAN)"
  protocol     = "udp"
  dst_port     = "5353"
  in_interface = routeros_interface_vlan.iot_vlan.name
}

# 4
# Comment is the RouterOS default-configuration string and is kept verbatim.
resource "routeros_ip_firewall_filter" "input_accept_icmp" {
  chain      = "input"
  action     = "accept"
  comment    = "defconf: accept ICMP"
  protocol   = "icmp"
  log_prefix = "icmp_allow"
}

# 5 — TERMINAL RULE for chain=input. Everything not accepted above is dropped
# here, including management access from outside BASE_VLAN.
resource "routeros_ip_firewall_filter" "input_drop_all" {
  chain      = "input"
  action     = "drop"
  comment    = "Drop All Other Input Traffic"
  log_prefix = "DROP_INPUT"
  # Pinned explicitly, same as the forward terminal drop: the provider
  # suppresses diffs for unset attributes, so omitting `disabled` would leave
  # whatever the device has. This asserts the input default-deny is ON.
  disabled = false
}

# ---------------------------------------------------------------------------
# chain=forward  (rules 6-17)
# ---------------------------------------------------------------------------

# 6 — the fasttrack rule must stay immediately above its matching accept (7);
# fasttracked packets bypass the rest of the chain.
resource "routeros_ip_firewall_filter" "forward_fasttrack_estab" {
  chain            = "forward"
  action           = "fasttrack-connection"
  comment          = "Allow Estab & Related"
  connection_state = "established,related"
}

# 7 — same comment and matcher as rule 6, different action. Two distinct rows
# on the device; the resource labels are what tells them apart here.
resource "routeros_ip_firewall_filter" "forward_accept_estab" {
  chain            = "forward"
  action           = "accept"
  comment          = "Allow Estab & Related"
  connection_state = "established,related"
}

# 8
# dst_address_list is the literal list name: the "k8s-cluster" list is a set of
# individual routeros_ip_firewall_addr_list rows in firewall-addr-lists.tf with
# no single resource representing the list itself, so there is nothing to
# reference.
#
# A second fasttrack rule ("Trusted VLAN to Cilium", .id *69) used to sit
# above this one; it was fully shadowed by rule 6 (which fasttracks ALL
# established,related traffic) and had lifetime counters of 0, so it was
# removed on 2026-07-30 (post-migration audit).
resource "routeros_ip_firewall_filter" "forward_accept_cilium" {
  chain            = "forward"
  action           = "accept"
  comment          = "Trusted VLAN to Cilium"
  connection_state = "new"
  dst_address_list = "k8s-cluster"
  in_interface     = routeros_interface_vlan.trusted_vlan.name
}

# 9
# src_address_list is the literal list name "kindles" for the same reason as
# "k8s-cluster" above — the list is a set of individual addr_list rows.
resource "routeros_ip_firewall_filter" "forward_accept_kindles_cilium" {
  chain            = "forward"
  action           = "accept"
  comment          = "Kindles to Cilium"
  connection_state = "new"
  dst_address_list = "k8s-cluster"
  src_address_list = "kindles"
}

# 10
resource "routeros_ip_firewall_filter" "forward_accept_squid" {
  chain            = "forward"
  action           = "accept"
  comment          = "Trusted VLAN to SQUID"
  connection_state = "new"
  dst_address      = "10.0.20.242"
  in_interface     = routeros_interface_vlan.trusted_vlan.name
}

# 11 — permanent workstation access to the switch (added 2026-07-30 at
# Aaron's request). TRUSTED→BASE_VLAN routed traffic has no other accept, so
# without this the switch becomes unreachable from the workstation the moment
# the terminal forward drop is re-enabled.
#
# A "Trusted VLAN to Owncast Ingest" accept (.id *79) used to sit above this
# rule; its match set was a strict subset of rule 8's (10.0.20.244 is in the
# k8s-cluster list, comment "owncast-ingress") and its lifetime counters were
# 0, so it was removed on 2026-07-30 (post-migration audit).
resource "routeros_ip_firewall_filter" "forward_accept_trusted_switch" {
  chain            = "forward"
  action           = "accept"
  comment          = "Trusted VLAN to EdgeSwitch mgmt"
  connection_state = "new"
  dst_address      = "192.168.0.2"
  in_interface     = routeros_interface_vlan.trusted_vlan.name
}

# 12
resource "routeros_ip_firewall_filter" "forward_accept_plex" {
  chain             = "forward"
  action            = "accept"
  comment           = "VLAN to Plex LB IP"
  connection_state  = "new"
  dst_address       = "10.0.20.245"
  in_interface_list = routeros_interface_list.plex_client.name
}

# 13 — printing to the IOT_VLAN (added 2026-07-30)
resource "routeros_ip_firewall_filter" "forward_accept_printer" {
  chain            = "forward"
  action           = "accept"
  comment          = "Trusted VLAN to Printer"
  connection_state = "new"
  protocol         = "tcp"
  dst_address      = routeros_ip_dhcp_server_lease.iot_printer.address
  dst_port         = "515,631,9100"
  in_interface     = routeros_interface_vlan.trusted_vlan.name
}

# 13a — casting to the IOT_VLAN soundbar (added 2026-10-22): Google Cast
# (8008/8009/8443) and Spotify Connect. Spotify uses a port the bar picks
# dynamically and advertises over mDNS (repeated by the router, see dns.tf),
# so there is no protocol/port matcher — the scope is the single destination
# host. AirPlay 2 is deliberately not supported: it would also need a
# soundbar→TRUSTED UDP accept (receiver-initiated timing/control flows).
resource "routeros_ip_firewall_filter" "forward_accept_soundbar" {
  chain            = "forward"
  action           = "accept"
  comment          = "Trusted VLAN to Soundbar"
  connection_state = "new"
  dst_address      = routeros_ip_dhcp_server_lease.iot_soundbar.address
  in_interface     = routeros_interface_vlan.trusted_vlan.name
}

# 14
resource "routeros_ip_firewall_filter" "forward_accept_vlan_internet" {
  chain              = "forward"
  action             = "accept"
  comment            = "Allow VLAN Internet Access only"
  connection_state   = "new"
  in_interface_list  = routeros_interface_list.vlan.name
  out_interface_list = routeros_interface_list.wan.name
}

# 15
# No connection_state matcher on the live row — matched on port/protocol only.
resource "routeros_ip_firewall_filter" "forward_accept_soulseek" {
  chain             = "forward"
  action            = "accept"
  comment           = "SoulSeek"
  dst_address       = "10.0.20.244"
  dst_port          = "50300"
  in_interface_list = routeros_interface_list.wan.name
  protocol          = "tcp"
}

# 16
# connection_nat_state = "dstnat" is the provider attribute for the live
# connection-nat-state=dstnat matcher; it pairs with the dst-nat rule of the
# same name in nat.tf. No in-interface matcher on this row.
resource "routeros_ip_firewall_filter" "forward_accept_palworld" {
  chain                = "forward"
  action               = "accept"
  comment              = "palworld udp"
  connection_nat_state = "dstnat"
  dst_address          = "10.0.20.246"
  dst_port             = "8211"
  protocol             = "udp"
}

# 17 — TERMINAL RULE for chain=forward: the default-deny for all inter-VLAN
# and inbound traffic not matched by rules 6-16.
#
# History: found disabled on the live device during the 2026-07-30 migration
# (Aaron had turned it off temporarily for workstation→switch access during
# setup). Re-enabled 2026-07-30 after the permanent "Trusted VLAN to
# EdgeSwitch mgmt" accept (rule 12a) made the workaround unnecessary.
resource "routeros_ip_firewall_filter" "forward_drop_all" {
  chain   = "forward"
  action  = "drop"
  comment = "Drop All Other Forward"
  # Pinned explicitly: the provider suppresses diffs for unset attributes, so
  # omitting `disabled` would leave whatever the device has. This asserts the
  # default-deny is ON.
  disabled = false
}

# ---------------------------------------------------------------------------
# Filter rule order
# ---------------------------------------------------------------------------
#
# routeros_move_items asserts the on-device order of the 23 rules above.
# Behaviour verified in the provider source (routeros/resource_move.go,
# v1.99.1):
#
#   * Attributes are exactly `resource_path` (or `resource_name`) and
#     `sequence`. There is no `anchor_rule` — it is commented out in the source.
#   * Create/Update issue a single RouterOS move:
#       numbers     = sequence[0 .. n-2]
#       destination = sequence[n-1]
#     i.e. all but the last id are moved to sit immediately before the LAST id
#     in the list. So the last element of `sequence` is the anchor, and its own
#     absolute position in the chain is not asserted — which is why the
#     terminal drop rule is intentionally last here.
#   * Read re-reads the whole menu, keeps only the ids named in `sequence`, and
#     writes them back in on-device order. When the device order already equals
#     the configured order, state equals config, there is no diff, and NO move
#     request is sent. It genuinely no-ops on a correctly ordered device.
#   * The read only checks the relative order of the managed ids. The source
#     carries a TODO saying as much ("This check will not work in all cases!!!")
#     — a foreign rule manually inserted between two managed rules will NOT be
#     detected.
#   * There is no Importer on this resource, so it cannot be imported and has
#     no import block. It is created on the first apply, and that create always
#     sends the move once, unconditionally. Because the device is already in
#     this exact order, that move is a functional no-op.
#   * Destroy only drops it from state (DefaultSystemDelete) and emits a
#     warning; it never deletes or reorders rules.
#
# depends_on covers all 23 rules so the move cannot be attempted before every
# rule exists in state.
resource "routeros_move_items" "firewall_filter_order" {
  resource_path = "/ip/firewall/filter"

  sequence = [
    routeros_ip_firewall_filter.input_accept_estab.id,            # 1
    routeros_ip_firewall_filter.input_accept_vlan.id,             # 2
    routeros_ip_firewall_filter.input_accept_base_vlan.id,        # 3
    routeros_ip_firewall_filter.input_accept_dns_udp.id,          # 3a
    routeros_ip_firewall_filter.input_accept_dns_tcp.id,          # 3b
    routeros_ip_firewall_filter.input_accept_dhcp.id,             # 3c
    routeros_ip_firewall_filter.input_accept_bgp.id,              # 3d
    routeros_ip_firewall_filter.input_accept_externaldns_api.id,  # 3d2
    routeros_ip_firewall_filter.input_accept_mdns_iot.id,         # 3e
    routeros_ip_firewall_filter.input_accept_icmp.id,             # 4
    routeros_ip_firewall_filter.input_drop_all.id,                # 5
    routeros_ip_firewall_filter.forward_fasttrack_estab.id,       # 6
    routeros_ip_firewall_filter.forward_accept_estab.id,          # 7
    routeros_ip_firewall_filter.forward_accept_cilium.id,         # 8
    routeros_ip_firewall_filter.forward_accept_kindles_cilium.id, # 9
    routeros_ip_firewall_filter.forward_accept_squid.id,          # 10
    routeros_ip_firewall_filter.forward_accept_trusted_switch.id, # 11
    routeros_ip_firewall_filter.forward_accept_plex.id,           # 12
    routeros_ip_firewall_filter.forward_accept_printer.id,        # 13
    routeros_ip_firewall_filter.forward_accept_soundbar.id,       # 13a
    routeros_ip_firewall_filter.forward_accept_vlan_internet.id,  # 14
    routeros_ip_firewall_filter.forward_accept_soulseek.id,       # 15
    routeros_ip_firewall_filter.forward_accept_palworld.id,       # 16
    routeros_ip_firewall_filter.forward_drop_all.id,              # 17 (anchor)
  ]

  depends_on = [
    routeros_ip_firewall_filter.input_accept_estab,
    routeros_ip_firewall_filter.input_accept_vlan,
    routeros_ip_firewall_filter.input_accept_dns_udp,
    routeros_ip_firewall_filter.input_accept_dns_tcp,
    routeros_ip_firewall_filter.input_accept_dhcp,
    routeros_ip_firewall_filter.input_accept_bgp,
    routeros_ip_firewall_filter.input_accept_externaldns_api,
    routeros_ip_firewall_filter.input_accept_mdns_iot,
    routeros_ip_firewall_filter.forward_accept_trusted_switch,
    routeros_ip_firewall_filter.input_accept_base_vlan,
    routeros_ip_firewall_filter.input_accept_icmp,
    routeros_ip_firewall_filter.input_drop_all,
    routeros_ip_firewall_filter.forward_fasttrack_estab,
    routeros_ip_firewall_filter.forward_accept_estab,
    routeros_ip_firewall_filter.forward_accept_cilium,
    routeros_ip_firewall_filter.forward_accept_kindles_cilium,
    routeros_ip_firewall_filter.forward_accept_squid,
    routeros_ip_firewall_filter.forward_accept_plex,
    routeros_ip_firewall_filter.forward_accept_printer,
    routeros_ip_firewall_filter.forward_accept_soundbar,
    routeros_ip_firewall_filter.forward_accept_vlan_internet,
    routeros_ip_firewall_filter.forward_accept_soulseek,
    routeros_ip_firewall_filter.forward_accept_palworld,
    routeros_ip_firewall_filter.forward_drop_all,
  ]
}
