# Bridge

resource "routeros_interface_bridge" "br1" {
  name           = "BR1"
  protocol_mode  = "none"
  vlan_filtering = true

  lifecycle {
    prevent_destroy = true
  }
}

# Bridge ports

# ether1 is the out-of-band recovery port (MIGRATION-BRIEF 7.1). It is a
# hybrid port, not a pure access port: untagged/pvid VLAN 99 plus tagged
# membership of VLANs 10, 30 and 40 (see the bridge-VLAN rows below), with
# frame-types unrestricted so any frame can reach the router during recovery.
# VLAN 20 (SERVER_VLAN) is deliberately NOT tagged here — the k8s/server
# network stays off the physical recovery jack.
resource "routeros_interface_bridge_port" "ether1" {
  bridge    = routeros_interface_bridge.br1.name
  interface = routeros_interface_ethernet.ether1.name
  pvid      = 99
}

resource "routeros_interface_bridge_port" "ether3" {
  bridge      = routeros_interface_bridge.br1.name
  interface   = routeros_interface_ethernet.ether3.name
  pvid        = 10
  frame_types = "admit-only-untagged-and-priority-tagged"
}

resource "routeros_interface_bridge_port" "ether4" {
  bridge      = routeros_interface_bridge.br1.name
  interface   = routeros_interface_ethernet.ether4.name
  pvid        = 20
  frame_types = "admit-only-untagged-and-priority-tagged"
}

resource "routeros_interface_bridge_port" "ether5" {
  bridge      = routeros_interface_bridge.br1.name
  interface   = routeros_interface_ethernet.ether5.name
  pvid        = 20
  frame_types = "admit-only-untagged-and-priority-tagged"
}

resource "routeros_interface_bridge_port" "ether6" {
  bridge      = routeros_interface_bridge.br1.name
  interface   = routeros_interface_ethernet.ether6.name
  pvid        = 20
  frame_types = "admit-only-untagged-and-priority-tagged"
}

resource "routeros_interface_bridge_port" "ether7" {
  bridge      = routeros_interface_bridge.br1.name
  interface   = routeros_interface_ethernet.ether7.name
  pvid        = 40
  frame_types = "admit-only-untagged-and-priority-tagged"
}

resource "routeros_interface_bridge_port" "ether8" {
  bridge      = routeros_interface_bridge.br1.name
  interface   = routeros_interface_ethernet.ether8.name
  pvid        = 20
  frame_types = "admit-only-untagged-and-priority-tagged"
}

# Switch uplink trunk (router sfp-sfpplus1 -> switch sfp-sfpplus2).
# ingress_filtering = false is a genuine non-default here (RouterOS defaults it
# to true). If VLAN 99 tagging on this port breaks, the switch at 192.168.0.2
# becomes unreachable and stays unreachable (MIGRATION-BRIEF 7.1).
resource "routeros_interface_bridge_port" "sfp_sfpplus1" {
  bridge            = routeros_interface_bridge.br1.name
  interface         = routeros_interface_ethernet.sfp_sfpplus1.name
  pvid              = 99
  frame_types       = "admit-only-vlan-tagged"
  ingress_filtering = false

  lifecycle {
    prevent_destroy = true
  }
}

# Bridge VLANs (static entries only)
# VLANs 1, 10, 20, 40 and 99 also exist as dynamic "added by pvid" rows; those
# are generated by RouterOS from the bridge-port pvids above and are
# intentionally not managed here.

resource "routeros_interface_bridge_vlan" "vlan10" {
  bridge   = routeros_interface_bridge.br1.name
  vlan_ids = ["10"]
  tagged = [
    routeros_interface_bridge.br1.name,
    routeros_interface_ethernet.sfp_sfpplus1.name,
    routeros_interface_ethernet.ether1.name,
  ]
}

resource "routeros_interface_bridge_vlan" "vlan20" {
  bridge   = routeros_interface_bridge.br1.name
  vlan_ids = ["20"]
  tagged = [
    routeros_interface_bridge.br1.name,
    routeros_interface_ethernet.sfp_sfpplus1.name,
  ]
}

resource "routeros_interface_bridge_vlan" "vlan30" {
  bridge   = routeros_interface_bridge.br1.name
  vlan_ids = ["30"]
  tagged = [
    routeros_interface_bridge.br1.name,
    routeros_interface_ethernet.sfp_sfpplus1.name,
    routeros_interface_ethernet.ether1.name,
  ]
}

resource "routeros_interface_bridge_vlan" "vlan40" {
  bridge   = routeros_interface_bridge.br1.name
  vlan_ids = ["40"]
  tagged = [
    routeros_interface_bridge.br1.name,
    routeros_interface_ethernet.sfp_sfpplus1.name,
    routeros_interface_ethernet.ether1.name,
  ]
}

# Management VLAN -- BR1 itself is tagged so BASE_VLAN stays reachable, and
# sfp-sfpplus1 carries it to the switch.
resource "routeros_interface_bridge_vlan" "vlan99" {
  bridge   = routeros_interface_bridge.br1.name
  vlan_ids = ["99"]
  tagged = [
    routeros_interface_bridge.br1.name,
    routeros_interface_ethernet.sfp_sfpplus1.name,
  ]

  lifecycle {
    prevent_destroy = true
  }
}
